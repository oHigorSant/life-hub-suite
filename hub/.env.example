# Life Hub — variáveis de ambiente. Copie para `.env.local` (o `npm run setup` da raiz já faz isso e gera os segredos).
# `.env.local` NUNCA vai para o git. Variáveis NEXT_PUBLIC_* são lidas no BUILD (rode `npm run build` de novo ao mudar).

# ---- Acesso (obrigatório) -------------------------------------------------------------------
# Senha que você digita na tela de login.
LIFEHUB_PASSWORD=
# Valor aleatório que vira o cookie de sessão. Trocar desloga todos os aparelhos.
LIFEHUB_AUTH_TOKEN=

# ---- Aparência / integração entre os apps ---------------------------------------------------
# Nome na saudação da Home (opcional).
NEXT_PUBLIC_LIFEHUB_USER=
# Coloque 0 para esconder o app Trilhas (item da sidebar + widget da Home). Padrão: ligado.
# NEXT_PUBLIC_LIFEHUB_TRILHAS=0
# Onde o app Trilhas roda (o Hub faz proxy de /trilhas-app para ele). Padrão: http://127.0.0.1:4300
# TRILHAS_URL=http://127.0.0.1:4300
# URL pública do Hub (usada como referer nas chamadas ao OpenRouter e no QR do Pluggy). Opcional.
# LIFEHUB_PUBLIC_URL=

# ---- Motores de IA (todos opcionais; o agente usa o que estiver disponível) -----------------
# 1) Claude: não precisa de variável — usa o Claude Code instalado e logado nesta máquina (`claude` no PATH).
# 2) Gemini (grátis, Google AI Studio). Uma chave ou várias separadas por vírgula.
GEMINI_API_KEY=
GEMINI_API_KEYS=
# 3) OpenRouter (pago). A "management key" só serve para mostrar saldo na tela Motores.
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=

# ---- Módulos opcionais ----------------------------------------------------------------------
# Open Finance (Finanças > Bancos): https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Bíblia (YouVersion Platform): https://developers.youversion.com
YOUVERSION_APP_KEY=
# Voz do podcast em Estudos (serviço TTS compatível com OpenAI em /v1/audio/speech). Sem ele, cai no Piper local ou fica sem áudio.
# VOICESTUDIO_URL=http://127.0.0.1:3900
